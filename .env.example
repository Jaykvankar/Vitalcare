# Copy via: python scripts/init_env.py  (generates real random values)
RPM_MASTER_KEY=<base64 of 32 random bytes>
RPM_MASTER_KEY_VERSION=1
RPM_PREVIOUS_MASTER_KEYS=
RPM_SIM_PASSPHRASE=<random passphrase>
RPM_SELF_URL=https://localhost:8443
RPM_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
# DATABASE_URL=postgresql+psycopg://rpm:password@localhost:5432/rpm
POSTGRES_PASSWORD=<random password for docker compose>
